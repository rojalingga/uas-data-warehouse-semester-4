    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>var s = order_purchase_timestamp.toString();

var year  = s.substring(24,28);
var monthTxt = s.substring(4,7);
var day   = s.substring(8,10);

var month = "01";

if(monthTxt=="Jan") month="01";
if(monthTxt=="Feb") month="02";
if(monthTxt=="Mar") month="03";
if(monthTxt=="Apr") month="04";
if(monthTxt=="May") month="05";
if(monthTxt=="Jun") month="06";
if(monthTxt=="Jul") month="07";
if(monthTxt=="Aug") month="08";
if(monthTxt=="Sep") month="09";
if(monthTxt=="Oct") month="10";
if(monthTxt=="Nov") month="11";
if(monthTxt=="Dec") month="12";

date_key = parseInt(year + month + day);</jsScript_script>
      </jsScript>
    </jsScripts>
